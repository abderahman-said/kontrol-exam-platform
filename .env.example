# ==========================================
# Kontrol SaaS - متغيرات بيئة الإنتاج
# ==========================================

# البيئة والمنفذ
NODE_ENV=production
PORT=5000

# قاعدة البيانات (PostgreSQL للإنتاج أو SQLite للتطوير المحلي)
DATABASE_URL="postgresql://user:password@localhost:5432/kontrol_db?schema=public"

# الأمان وتشفير الجلسات
JWT_SECRET="generate-a-very-strong-64-character-random-secret"

# التخزين السحابي لملفات PDF والأسئلة (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="kontrol-exams"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# بوابات الدفع المصرية (Paymob / فوري)
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_INTEGRATION_ID="your-card-integration-id"
PAYMOB_IFRAME_ID="your-iframe-id"
PAYMOB_HMAC_SECRET="your-hmac-secret"

# الواتساب للرسائل التلقائية (UltraMsg أو Meta Cloud API)
WHATSAPP_INSTANCE_ID="instance12345"
WHATSAPP_TOKEN="your-ultramsg-token"

# الذكاء الاصطناعي (Google Gemini AI Explainer)
GEMINI_API_KEY="your-google-gemini-api-key"
