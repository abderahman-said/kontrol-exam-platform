# ===================================================================
# Kontrol Platform (كَنترول) - Environment Variables Template
# ===================================================================

# السيرفر والمنفذ (على Render/Railway يتم تعيين PORT تلقائياً)
NODE_ENV=production
PORT=5000

# رابط قاعدة البيانات (SQLite افتراضياً - أو PostgreSQL)
# لـ SQLite: file:./dev.db
# لـ PostgreSQL: postgresql://username:password@host:5432/database?schema=public
DATABASE_URL="file:./dev.db"

# المفتاح السري لتشفير جلسات التوكن JWT
JWT_SECRET="smart-exam-secret-key-2026-kontrol-production"

# السماح بروابط الفرونت إند في الـ CORS (* لكل النطاقات أو رابط فيرسل مثل https://your-frontend.vercel.app)
CORS_ORIGIN="*"

# ===================================================================
# إعدادات الذكاء الاصطناعي (Google Gemini AI)
# ===================================================================
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_KEY_NAME="quizExams"
GEMINI_PROJECT_NAME="your-gemini-project"
GEMINI_PROJECT_NUMBER="your-gemini-project-number"

# مفاتيح اختيارية بديلة (Optional)
OPENAI_API_KEY=""
GROQ_API_KEY=""
